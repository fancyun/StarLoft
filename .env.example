# ========================
# 环境变量配置文件
# ========================
# 使用方法: cp .env.example .env，然后修改下面的值

# ================
# 服务器配置
# ================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
GIN_MODE=release

# ================
# 数据库配置（云数据库）
# ================
# 生产环境使用云数据库，填写真实的云数据库连接信息
DB_HOST=your-cloud-mysql-host.example.com
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_secure_mysql_password_here
DB_NAME=kyc_platform
DB_MAX_IDLE_CONNS=50
DB_MAX_OPEN_CONNS=200

# ================
# Redis配置（Docker本地Redis）
# ================
REDIS_PASSWORD=your_redis_strong_password_here

# ================
# JWT配置
# ================
JWT_SECRET=your_generated_jwt_secret_32_bytes
JWT_ADMIN_SECRET=your_generated_admin_jwt_secret_32_bytes
JWT_EXPIRE_HOURS=24

# ================
# 数据加密密钥（32字节）
# ================
ENCRYPTION_KEY=your_generated_encryption_key_32_bytes

# ================
# FinAuth实名认证API配置
# ================
FINAUTH_API_KEY=your_finauth_api_key
FINAUTH_API_SECRET=your_finauth_api_secret
FINAUTH_SCENE_ID=kyc
FINAUTH_BASE_URL=https://api.yljz.com
FINAUTH_RETURN_URL=https://kyc.starloft.cn/kyc
FINAUTH_NOTIFY_URL=https://kyc.starloft.cn/api/v1/callback/finauth

# ================
# 腾讯云配置（短信+验证码）
# ================
TENCENT_SECRET_ID=your_tencent_secret_id
TENCENT_SECRET_KEY=your_tencent_secret_key
TENCENT_SMS_SIGN_NAME=星楼网络
TENCENT_SMS_SDK_APP_ID=your_sdk_app_id
TENCENT_SMS_TEMPLATE_ID=your_template_id
TENCENT_CAPTCHA_APP_ID=197971702
TENCENT_CAPTCHA_SECRET=your_tencent_captcha_secret

# ================
# 银联支付配置
# ================
UNIONPAY_MERCHANT_NO=your_merchant_id
UNIONPAY_TERMINAL_NO=your_terminal_id
UNIONPAY_ACCESS_TOKEN=your_unionpay_access_token
UNIONPAY_SIGN_KEY=your_unionpay_sign_key
UNIONPAY_API_URL=https://qr.chinaums.com
UNIONPAY_NOTIFY_URL=https://kyc.starloft.cn/api/v1/callback/payment

# ================
# Docker Compose端口映射
# ================
# 生产环境配置：
# - 后端不暴露端口（通过前端Nginx代理访问）
# - 前端暴露80和443端口
FRONTEND_PORT=80
FRONTEND_HTTPS_PORT=443

# ================
# 快速生成密钥命令
# ================
# Linux/Mac:
#   openssl rand -base64 32
#
# Windows PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
#
# 生成多个密钥:
#   for i in {1..3}; do openssl rand -base64 32; done
