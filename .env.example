# ========================
# 环境变量配置文件
# ========================

# ================
# 服务器配置
# ================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
GIN_MODE=release

# ================
# 数据库配置（云数据库）
# ================
# 生产环境使用云数据库，填写真实的云数据库连接信息
DB_HOST=your-cloud-mysql-host.example.com
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_secure_mysql_password_here
DB_NAME=kyc_platform
DB_MAX_IDLE_CONNS=50
DB_MAX_OPEN_CONNS=200

# ================
# Redis配置（Docker本地Redis）
# ================
REDIS_PASSWORD=your_redis_strong_password_here

# ================
# JWT配置
# ================
JWT_SECRET=your_generated_jwt_secret_32_bytes
JWT_ADMIN_SECRET=your_generated_admin_jwt_secret_32_bytes
JWT_EXPIRE_HOURS=24

# ================
# FinAuth实名认证API配置
# ================
FINAUTH_API_KEY=your_finauth_api_key
FINAUTH_API_SECRET=your_finauth_api_secret
FINAUTH_SCENE_ID=kyc
FINAUTH_BASE_URL=https://api.yljz.com

# ================
# 腾讯云配置（短信、人机验证、邮件 SES）
# ================
TENCENT_SECRET_ID=your_tencent_secret_id
TENCENT_SECRET_KEY=your_tencent_secret_key

# --- 短信（SMS）---
TENCENT_SMS_SIGN_NAME=星楼网络
TENCENT_SMS_SDK_APP_ID=your_sdk_app_id
TENCENT_SMS_TEMPLATE_ID=your_template_id

# --- 人机验证（天御验证码）---
TENCENT_CAPTCHA_APP_ID=197971702
TENCENT_CAPTCHA_SECRET=your_tencent_captcha_secret

# --- 邮件推送（SES，用于发送邮箱验证码）---
# 需开通腾讯云邮件推送，完成发信域名验证并创建发信地址与发信模板（模板变量为 {{code}}）
SES_FROM=your_sender@example.com
SES_TEMPLATE_ID=your_template_id
SES_REGION=ap-guangzhou

# ================
# 支付宝支付配置（电脑网站支付）
# 密钥为单行书写，换行用字面 \n 表示
# ================
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_PRIVATE_KEY=your_alipay_private_key_pem
ALIPAY_PUBLIC_KEY=your_alipay_public_key_pem
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# ================
# 微信支付配置（Native支付）
# 密钥为单行书写，换行用字面 \n 表示
# ================
WECHAT_APP_ID=your_wechat_appid
WECHAT_MCH_ID=your_wechat_mchid
WECHAT_API_V3_KEY=your_apiv3_key
WECHAT_MCH_SERIAL_NO=your_mch_serial_no
WECHAT_MCH_PRIVATE_KEY=your_mch_private_key_pem
WECHAT_PLATFORM_PUBLIC_KEY=your_wechat_pay_public_key_pem

# ================
# 日志配置（容器内落盘目录，docker-compose 已映射数据卷 backend_logs）
# ================
LOG_DIR=/app/logs

# ================
# Docker Compose端口映射
# ================
# 生产环境配置：
# - 后端不暴露端口（通过前端Nginx代理访问）
# - 前端暴露80和443端口
FRONTEND_PORT=80
FRONTEND_HTTPS_PORT=443
