# ========================
# 环境变量配置文件
# ========================
# 全部配置（含第三方业务配置）均由 .env 环境变量管理：
# FinAuth实名认证 / 腾讯云短信 / 验证码 / 邮件 / 支付宝 / 微信支付 / KYC单价。
# 修改后需重启后端生效（已取消 system_config 表在线配置）。

# ================
# 服务器配置
# ================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
GIN_MODE=release

# ================
# 数据库连接（本地 Docker MySQL 或云数据库；分库库名已固定写死）
# ================
# Docker Compose 部署时 DB_HOST 为 compose 内的 mysql 服务名，需与 mysql 服务 root 密码一致
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password_here
DB_MAX_IDLE_CONNS=50
DB_MAX_OPEN_CONNS=200

# ================
# Redis（Docker 本地 Redis 容器）
# ================
REDIS_PASSWORD=your_redis_strong_password_here

# ================
# JWT
# ================
JWT_SECRET=your_generated_jwt_secret_32_bytes
JWT_ADMIN_SECRET=your_generated_admin_jwt_secret_32_bytes
JWT_EXPIRE_HOURS=24

# ================
# 日志目录（容器内 /app/logs，已挂载宿主项目 ./logs）
# ================
LOG_DIR=/app/logs

# ================
# 平台 KYC 认证单价（元/次，API 认证计费与前端展示）
# ================
KYC_PRICE=1.00

# ================
# FinAuth 实名认证（上游人证核验）
# ================
FINAUTH_API_KEY=your_finauth_api_key
FINAUTH_API_SECRET=your_finauth_api_secret
FINAUTH_SCENE_ID=your_finauth_scene_id
FINAUTH_BASE_URL=https://your_finauth_base_url

# ================
# 腾讯云账号密钥（短信/验证码/邮件共用）
# ================
TENCENT_SECRET_ID=your_tencent_secret_id
TENCENT_SECRET_KEY=your_tencent_secret_key

# ================
# 腾讯云短信（SMS）
# ================
TENCENT_SMS_SDK_APP_ID=1400000000
TENCENT_SMS_SIGN_NAME=your_sms_sign_name
TENCENT_SMS_TEMPLATE_ID=your_sms_template_id

# ================
# 腾讯云天御验证码
# ================
TENCENT_CAPTCHA_APP_ID=your_captcha_app_id
TENCENT_CAPTCHA_SECRET=your_captcha_secret

# ================
# 腾讯云邮件（SES）
# ================
SES_FROM=your_sender@example.com
SES_TEMPLATE_ID=your_ses_template_id
SES_REGION=ap-guangzhou

# ================
# 支付宝开放平台支付（电脑网站支付 alipay.trade.page.pay，PEM 私钥/公钥单行 \n 书写）
# ================
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_PRIVATE_KEY=your_alipay_private_key
ALIPAY_PUBLIC_KEY=your_alipay_public_key

# ================
# 微信支付（APIv3 Native，PEM 私钥/公钥单行 \n 书写）
# ================
WECHAT_APP_ID=your_wechat_app_id
WECHAT_MCH_ID=your_wechat_mch_id
WECHAT_API_V3_KEY=your_wechat_api_v3_key
WECHAT_MCH_SERIAL_NO=your_wechat_mch_serial_no
WECHAT_MCH_PRIVATE_KEY=your_wechat_mch_private_key
WECHAT_PLATFORM_PUBLIC_KEY=your_wechat_platform_public_key

# ================
# Docker Compose 端口映射
# ================
FRONTEND_PORT=80
FRONTEND_HTTPS_PORT=443